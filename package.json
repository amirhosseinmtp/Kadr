{
  "name": "kadr-film-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build && tsc -p server/tsconfig.json",
    "start": "node server-dist/server/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/src/domain/scenes.test.ts server/src/domain/call-sheet.test.ts server/src/domain/budget.test.ts server/src/services/auth.test.ts",
    "test:workflow": "node scripts/workflow-persistence.test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
